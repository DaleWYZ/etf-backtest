{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "启动 ETF 回测工具",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--host=127.0.0.1",
                "--port=5000",
                "--no-reload"
            ],
            "jinja": false,
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "直接运行 main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}
